<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Redirect directly requested /public URLs to their clean public equivalent.
    # THE_REQUEST ensures Laravel's internal rewrite does not trigger this redirect.
    RewriteCond %{THE_REQUEST} \s/+public(?:[/?\s]) [NC]
    RewriteRule ^public(?:/(.*))?$ /$1 [R=301,L,NE]

    # Allow SSL/domain validation files to remain accessible from the project root.
    RewriteRule ^\.well-known/ - [L]

    # Sitemap XML is the only non-homepage URL without a trailing slash.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} \.xml/$ [NC]
    RewriteRule ^(.+\.xml)/$ /$1 [R=301,L,NE]

    # Every public page except the homepage and sitemap.xml uses a trailing slash.
    # Keep this before the internal rewrite to the public directory.
    RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !/$
    RewriteCond %{REQUEST_URI} !^/(?:admin|api|sanctum)(?:/|$) [NC]
    RewriteCond %{REQUEST_URI} !^/submit- [NC]
    RewriteCond %{REQUEST_URI} !\.xml$ [NC]
    RewriteCond %{REQUEST_URI} !\.[a-z0-9]+$ [NC]
    RewriteRule ^(.+)$ /$1/ [R=301,L,NE]

    # Prevent a rewrite loop after handing the request to Laravel's public folder.
    RewriteRule ^public/ - [L]

    # Use the public directory as the web root on shared hosting.
    RewriteRule ^$ public/ [L]
    RewriteRule ^(.+)$ public/$1 [L]
</IfModule>

# Block direct web access to application and environment files.
<FilesMatch "(^\.env|^artisan$|^composer\.(json|lock)$|^package(-lock)?\.json$|^phpunit\.xml$)">
    Require all denied
</FilesMatch>
